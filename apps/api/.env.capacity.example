# Copy this file to apps/api/.env.capacity. Never commit the copied file.
# Use credentials that belong only to the isolated capacity environment.

AWS_ACCESS_KEY_ID=replace_with_capacity_identity
AWS_SECRET_ACCESS_KEY=replace_with_capacity_secret
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=replace_with_capacity_bucket

# Use a separate OpenAI project/service-account key.
OPENAI_API_KEY=replace_with_capacity_project_key
MODEL_NAME=replace_with_reviewed_vision_model
IMAGE_GENERATION_MODEL=replace_with_reviewed_image_model

# Use a separate Langfuse project, or at minimum this dedicated environment.
LANGFUSE_PUBLIC_KEY=replace_with_capacity_public_key
LANGFUSE_SECRET_KEY=replace_with_capacity_secret_key
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_ENVIRONMENT=production-capacity-local

# Store the complete header value. Generate a new random value for this stack.
CAPACITY_METRICS_AUTHORIZATION="Bearer replace_with_long_random_secret"

# DATABASE_URL is overridden by compose.production-capacity.local.yaml.
DATABASE_URL=postgresql+psycopg://unused:unused@database:5432/unused
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
S3_PRESIGNED_URL_EXPIRES=600
MAX_UPLOAD_BYTES=10485760
FRONTEND_ORIGIN=http://localhost:5273
LOG_LEVEL=INFO
