AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=replace_me

OPENAI_API_KEY=replace_me
MODEL_NAME=gpt-4.1-mini
IMAGE_GENERATION_MODEL=gpt-image-1

# Langfuse observability. Keep real keys only in apps/api/.env.
LANGFUSE_PUBLIC_KEY=replace_me
LANGFUSE_SECRET_KEY=replace_me
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_ENVIRONMENT=local-evaluation

# Optional protected endpoint for an explicitly authorized capacity test.
# Use a long random complete Authorization header value, for example
# "Bearer <secret>", and restrict the route at the network layer too.
CAPACITY_METRICS_AUTHORIZATION=

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_image
S3_PRESIGNED_URL_EXPIRES=600
MAX_UPLOAD_BYTES=10485760
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
